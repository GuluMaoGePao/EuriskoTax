# EuriskoTax 后端环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env

# 服务端口
PORT=3000

# 运行环境（development / production）
NODE_ENV=development

# JWT 密钥（生产环境必须用强密钥：openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me

# 数据库连接串
# 开发环境（SQLite）：
DATABASE_URL=file:./dev.db
# 生产环境（PostgreSQL，由 Zeabur 自动注入）：
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS 允许的源（生产环境填实际域名，如 https://euriskotax.zeabur.app）
CORS_ORIGIN=*

# 运营统计接口的管理员令牌（访问 GET /api/stats/overview 时通过 X-Admin-Token 头传入）
# 生产环境建议用强随机值：openssl rand -hex 16
ADMIN_TOKEN=dev-admin-token-change-me

# 【已废弃】邀请码改为一机一码数据库机制（InviteCode 表），不再使用环境变量
# 首批码由服务启动时自动生成（表空时打印到日志）；补充生成用：
#   node scripts/generate-invite-codes.js 20

# SMTP 邮件服务（注册验证码；QQ 邮箱示例：smtp.qq.com / 465 / 授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-mail@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM_NAME=EuriskoTax
# 465 端口留空或填 true（SSL 直连）；587 端口填 false（STARTTLS）
SMTP_SECURE=
