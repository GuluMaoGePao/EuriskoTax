# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 服务端口（云平台会自动设置）
PORT=3000

# JWT 密钥（生产环境必须设置一个随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT 过期时间（例如：1d、7d、12h、3600s）
JWT_EXPIRES_IN=7d

# bcrypt 加密轮数（10-12 为推荐值，越大越安全但越慢）
BCRYPT_ROUNDS=10

# 数据库路径（SQLite，默认在 prisma 目录下）
DATABASE_URL="file:./dev.db"

# CORS 允许的源（可选，默认允许所有）
# CORS_ORIGIN=https://your-frontend-domain.com