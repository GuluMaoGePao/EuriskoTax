generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  phone           String?
  password_hash   String
  // 账户分层（阶段10）：plan = "free" | "pro"
  plan            String    @default("free")
  plan_expires_at DateTime? // null = 永久
  pro_granted_by  String?   // 授权来源："seed" | "invite" | "admin" | "purchase"
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  calculations Calculation[]
  feedbacks     Feedback[]
}

model Calculation {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String
  client_id   String?  // 云端同步幂等键 = 本地记录 id；null 为历史 CRUD 期旧数据
  input_data  String
  result_data String
  updated_at  DateTime @default(now()) @updatedAt
  deleted_at  DateTime? // 软删墓碑：一端删除后同步给其它设备
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, client_id])
  @@index([user_id, updated_at])
}

// 邀请码（一机一码）：每个码仅可被一个账号使用，注册事务内原子消耗
model InviteCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  used_by    Int?
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([used_by])
}

// 邮箱验证码（注册等场景）：存哈希不存明文，带过期时间与错误尝试计数
model VerificationCode {
  id         Int      @id @default(autoincrement())
  email      String
  code_hash  String
  purpose    String   @default("register")
  attempts   Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email, purpose])
}

// 用户意见反馈：种子期收集 Bug/建议/评分，管理员跟进状态（open/resolved/closed）
model Feedback {
  id          Int      @id @default(autoincrement())
  user_id     Int
  category    String   @default("general") // bug / suggestion / other / general
  rating      Int?     // 评分 1-5，选填
  content     String
  // 附图（选填）：JSON 字符串数组，存前端压缩后的图片 data URL（限 3 张，服务端校验大小/类型）
  attachments String   @default("[]")
  status      String   @default("open")
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// 匿名计算埋点聚合表：登录用户保存计算时上报，仅记录计算类型，不含任何收入/扣除等输入数据
// date 存北京时间当日 0 点的 UTC 时刻，同一 (date, type) 按日聚合计数
model CalcEvent {
  id   Int      @id @default(autoincrement())
  date DateTime
  type String // comprehensive / business / classification / reverse
  count Int      @default(0)

  @@unique([date, type])
  @@index([date])
}

// 阶段11：内容中心条目（政策要点 / 更新公告 / 运营内容），后台可管理
// 注意：本表是「增量覆盖层」而非全量内容源——内置 QA 快照 window.TAX_ASSISTANT_QA 仍作离线兜底，
//       policy 类条目按 item_id 对内置条目 upsert/覆盖/deleted 撤回（与 tax-policy.js applyUpdates 语义一致）。
model ContentItem {
  id         Int       @id @default(autoincrement())
  item_id    String    @unique // 幂等键；policy 类与内置 QA id 对应
  type       String // policy / announcement / operation
  audience   String    @default("all") // all / free / pro
  placements String    @default("[]") // JSON 数组：assistant_qa / home_banner / modal / notice_list
  title      String    @default("")
  summary    String    @default("") // 横幅/卡片摘要
  body       String    @default("") // 正文（公告/运营内容）
  category   String? // policy：政策法规/综合所得…
  question   String? // policy：问答形式
  answer     String    @default("") // policy：答案
  keywords   String    @default("[]")
  hot        Boolean   @default(false) // policy：是否进「热门问题」
  link_url   String? // 运营内容/公告跳转
  link_text  String?
  priority   Int       @default(0) // 同展示位多条时排序
  status     String    @default("draft") // draft / published / revoked
  publish_at DateTime  @default(now()) // 定时上线
  expire_at  DateTime? // null = 永不过期
  updated_at DateTime  @updatedAt
  created_at DateTime  @default(now())

  @@index([type, status])
  @@index([status, audience])
}

// 阶段11：内容发布批次（提供 since 版本闸门 + 通知文案；草稿编辑不推送到端）
model ContentRelease {
  id           Int      @id @default(autoincrement())
  version      String   @unique // 如 2026.09.11-1
  notice       String   @default("")
  published_at DateTime @default(now())
  created_at   DateTime @default(now())
}