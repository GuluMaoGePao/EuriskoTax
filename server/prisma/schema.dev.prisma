// 本地开发专用 schema（SQLite，零配置）
// 生产环境使用 schema.prisma（PostgreSQL）；两者模型必须保持一致
// 用法：在 server 目录执行
//   npm run prisma:generate:dev
//   npm run prisma:push:dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  phone           String?
  password_hash   String
  // 账户分层（阶段10）：plan = "free" | "pro"
  plan            String    @default("free")
  plan_expires_at DateTime? // null = 永久
  pro_granted_by  String?   // 授权来源："seed" | "invite" | "admin" | "purchase"
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  calculations Calculation[]
  feedbacks     Feedback[]
}

model Calculation {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String
  client_id   String?  // 云端同步幂等键 = 本地记录 id；null 为历史 CRUD 期旧数据
  input_data  String
  result_data String
  updated_at  DateTime @default(now()) @updatedAt
  deleted_at  DateTime? // 软删墓碑：一端删除后同步给其它设备
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, client_id])
  @@index([user_id, updated_at])
}

// 邀请码（一机一码）：每个码仅可被一个账号使用，注册事务内原子消耗
model InviteCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  used_by    Int?
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([used_by])
}

// 邮箱验证码（注册等场景）：存哈希不存明文，带过期时间与错误尝试计数
model VerificationCode {
  id         Int      @id @default(autoincrement())
  email      String
  code_hash  String
  purpose    String   @default("register")
  attempts   Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email, purpose])
}

// 用户意见反馈：种子期收集 Bug/建议/评分，管理员跟进状态（open/resolved/closed）
model Feedback {
  id          Int      @id @default(autoincrement())
  user_id     Int
  category    String   @default("general") // bug / suggestion / other / general
  rating      Int?     // 评分 1-5，选填
  content     String
  // 附图（选填）：JSON 字符串数组，存前端压缩后的图片 data URL（限 3 张，服务端校验大小/类型）
  attachments String   @default("[]")
  status      String   @default("open")
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// 匿名计算埋点聚合表：登录用户保存计算时上报，仅记录计算类型，不含任何收入/扣除等输入数据
// date 存北京时间当日 0 点的 UTC 时刻，同一 (date, type) 按日聚合计数
model CalcEvent {
  id   Int      @id @default(autoincrement())
  date DateTime
  type String // comprehensive / business / classification / reverse
  count Int      @default(0)

  @@unique([date, type])
  @@index([date])
}
