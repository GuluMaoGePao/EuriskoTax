// 本地开发专用 schema（SQLite，零配置）
// 生产环境使用 schema.prisma（PostgreSQL）；两者模型必须保持一致
// 用法：在 server 目录执行
//   npm run prisma:generate:dev
//   npm run prisma:push:dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  phone           String?
  password_hash   String
  // 账户分层（阶段10）：plan = "free" | "pro"
  plan            String    @default("free")
  plan_expires_at DateTime? // null = 永久
  pro_granted_by  String?   // 授权来源："seed" | "invite" | "admin" | "purchase"
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  calculations Calculation[]
  feedbacks     Feedback[]
  leads         Lead[]
}

model Calculation {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String
  client_id   String?  // 云端同步幂等键 = 本地记录 id；null 为历史 CRUD 期旧数据
  input_data  String
  result_data String
  updated_at  DateTime @default(now()) @updatedAt
  deleted_at  DateTime? // 软删墓碑：一端删除后同步给其它设备
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, client_id])
  @@index([user_id, updated_at])
}

// 邀请码（一机一码）：每个码仅可被一个账号使用，注册事务内原子消耗
model InviteCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  used_by    Int?
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([used_by])
}

// 邮箱验证码（注册等场景）：存哈希不存明文，带过期时间与错误尝试计数
model VerificationCode {
  id         Int      @id @default(autoincrement())
  email      String
  code_hash  String
  purpose    String   @default("register")
  attempts   Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email, purpose])
}

// 用户意见反馈：种子期收集 Bug/建议/评分，管理员跟进状态（open/resolved/closed）
model Feedback {
  id          Int      @id @default(autoincrement())
  user_id     Int
  category    String   @default("general") // bug / suggestion / other / general
  rating      Int?     // 评分 1-5，选填
  content     String
  // 附图（选填）：JSON 字符串数组，存前端压缩后的图片 data URL（限 3 张，服务端校验大小/类型）
  attachments String   @default("[]")
  status      String   @default("open")
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// 匿名计算埋点聚合表：登录用户保存计算时上报，仅记录计算类型，不含任何收入/扣除等输入数据
// date 存北京时间当日 0 点的 UTC 时刻，同一 (date, type) 按日聚合计数
model CalcEvent {
  id   Int      @id @default(autoincrement())
  date DateTime
  type String // comprehensive / business / classification / reverse
  count Int      @default(0)

  @@unique([date, type])
  @@index([date])
}

// 阶段13E：转化漏斗埋点（visit / calc_done / share / save / lead_click）
// 为什么是「日粒度聚合」而不是「逐条事件」：
//   1) 北极星指标只需比值（lead_submit / calc_done），日粒度足够看趋势，聚合表查询极轻；
//   2) 不落任何个人标识（无 IP / 无设备 ID / 无 user_id），从结构上规避个保法风险；
//   3) upsert 自增天然幂等且抗刷——同一步骤同一天永远只有一行。
// 口径提醒：本表 calc_done 是「全量口径」（含游客与算完未保存），
//          与 CalcEvent（仅登录用户、仅在保存时上报、带 type 维度）不是同一个数，勿混用。
// lead_submit 不进本表——它的唯一真相是 Lead 表，同一事实只存一处。
model FunnelEvent {
  id    Int      @id @default(autoincrement())
  date  DateTime // 北京时间当日 0 点对应的 UTC 时刻
  step  String // visit / calc_done / share / save / lead_click
  count Int      @default(0)

  @@unique([date, step])
  @@index([date])
}

// 阶段11：内容中心条目（政策要点 / 更新公告 / 运营内容），后台可管理
// 注意：本表是「增量覆盖层」而非全量内容源——内置 QA 快照 window.TAX_ASSISTANT_QA 仍作离线兜底，
//       policy 类条目按 item_id 对内置条目 upsert/覆盖/deleted 撤回（与 tax-policy.js applyUpdates 语义一致）。
model ContentItem {
  id         Int       @id @default(autoincrement())
  item_id    String    @unique // 幂等键；policy 类与内置 QA id 对应
  type       String // policy / announcement / operation
  audience   String    @default("all") // all / free / pro
  placements String    @default("[]") // JSON 数组：assistant_qa / home_banner / modal / notice_list
  title      String    @default("")
  summary    String    @default("") // 横幅/卡片摘要
  body       String    @default("") // 正文（公告/运营内容）
  category   String? // policy：政策法规/综合所得…
  question   String? // policy：问答形式
  answer     String    @default("") // policy：答案
  keywords   String    @default("[]")
  hot        Boolean   @default(false) // policy：是否进「热门问题」
  link_url   String? // 运营内容/公告跳转
  link_text  String?
  priority   Int       @default(0) // 同展示位多条时排序
  status     String    @default("draft") // draft / published / revoked
  publish_at DateTime  @default(now()) // 定时上线
  expire_at  DateTime? // null = 永不过期
  updated_at DateTime  @updatedAt
  created_at DateTime  @default(now())

  @@index([type, status])
  @@index([status, audience])
}

// 阶段11：内容发布批次（提供 since 版本闸门 + 通知文案；草稿编辑不推送到端）
model ContentRelease {
  id           Int      @id @default(autoincrement())
  version      String   @unique // 如 2026.09.11-1
  notice       String   @default("")
  published_at DateTime @default(now())
  created_at   DateTime @default(now())
}

// 阶段12：排障话术库（客服处理用户问题的「症状 → 步骤 → 话术」清单）
// 刻意独立于 ContentItem：话术是内部客服资产，不参与用户端投放（ContentItem 有 placements/audience
// 分层与端上可见性判定），混在一起会有误投放风险。话术中的 {RESET_URL} 由端上替换为 /reset 短链。
model SupportScript {
  id         Int      @id @default(autoincrement())
  script_id  String   @unique // 幂等键；内置条目用固定 slug（如 stale-page），便于种子去重
  category   String   @default("cache") // cache / account / data / pay / usage
  title      String   @default("")
  symptom    String   @default("") // 典型症状
  steps      String   @default("[]") // JSON 字符串数组：处理步骤（有序）
  script     String   @default("") // 可直接复制发给用户的话术
  priority   Int      @default(0) // 排序，值大的靠前
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@index([category])
}

// 阶段12 C1：税制参数配置化（管理台热改税率）
// payload 为 JSON 字符串，含综合所得/月度/经营所得/分类所得税率表 + 缴费基数下限；
// 每次保存生成一条 published 快照，旧版本保留（archived）供审计与回滚；公开端点取最新一条。
// 约定：数组项 {min,max,rate,deduction}，无上限的 max 存 null（JSON 不支持 Infinity）。
model TaxRateConfig {
  id           Int      @id @default(autoincrement())
  version      String   @unique // 如 2026.2 / 2026.09.12-1
  status       String   @default("published") // published / archived
  payload      String   @default("{}")
  note         String   @default("") // 变更说明
  created_by   String   @default("admin")
  published_at DateTime @default(now())
  created_at   DateTime @default(now())

  @@index([status, published_at])
}

// 阶段13：转化线索（工具 → 服务）—— 会计/税务服务获客的枢纽
// 设计要点：
//   1) user_id 可空 + onDelete: SetNull：游客不登录也能留资；用户注销后线索仍可跟进（业务资产不随账号消失）
//   2) scene 情境快照：记录用户从哪类计算结果进入（如「经营所得·汇算清缴」），顾问跟进可精准开场
//   3) consent 显式同意：留资含收入相关敏感信息，个保法要求单独同意，必须留痕
//   4) status 状态机：new → contacted → qualified → converted / dropped（管理台跟进用）
model Lead {
  id          Int      @id @default(autoincrement())
  user_id     Int? // 可空：游客亦可留资
  name        String
  phone       String?
  wechat      String?
  company     String? // 公司 / 个体户名称
  entity_type String   @default("unknown") // individual / sole / small / other / unknown
  need        String   @default("") // 代理记账 / 汇算清缴 / 申报核对 / 咨询 / other
  source      String   @default("unknown") // 触点归因（见阶段13方案 §3.1）
  scene       String   @default("") // 情境快照
  note        String   @default("")
  consent     Boolean  @default(false) // 个保法显式同意留痕
  status      String   @default("new") // new / contacted / qualified / converted / dropped
  owner       String? // 跟进顾问
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([source])
  @@index([phone])
}
