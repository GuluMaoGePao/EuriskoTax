{
  "name": "EuriskoTax",
  "version": "1.12.0",
  "description": "个人所得税预算规划工具 - 全栈应用 + 运维守护 + GUI 控制台",
  "scripts": {
    "build": "echo 'Build complete - all files ready to deploy'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:performance": "node tests/performance/benchmark.js",
    "verify:local": "node server/scripts/verify-local-auth.js",
    "verify:pg": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ops/ops-verify-pg.ps1",
    "verify:pg:fresh": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ops/ops-verify-pg.ps1 -Fresh"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/js/calculation/tax-constants.js",
      "src/js/calculation/tax-calculator.js",
      "src/js/calculation/helper-functions.js",
      "src/js/calculation/utils.js",
      "src/js/calculation/engine.js",
      "src/js/data/scenario-store.js",
      "src/js/data/tax-rates-sync.js",
      "src/js/ui/scenario-ui.js",
      "src/js/ui/navigation-ui.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "html"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
