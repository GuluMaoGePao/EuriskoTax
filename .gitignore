# Dependencies
node_modules/
server/node_modules/

# Database
server/prisma/dev.db
server/prisma/*.db

# Environment variables
.env
.env.local
.env.*.local

# Watchdog notification config (contains SMTP credentials)
tools/ops/notify.config.json

# 门禁实跑口径快照（本机生成物：最近一次 verify:local 的项数，供文档口径守护比对）
tools/ops/.verify-local-last.json

# Deploy config (contains server credentials)
tools/ops/ops-deploy.config.json
tools/ops/deploy.config.json

# Account credentials doc (contains all passwords/tokens)
docs/admin/account-credentials.md

# 本机测试账号覆盖（本机自己用的邮箱 / 密码只留在这台机器上，仓库里只放可用的默认账号）
# 读取方：server/scripts/dev-account.js、tools/ops/dev-account.ps1、登录页预填、GUI 复制按钮
dev-account.local.json

# Logs：忽略目录里的内容，但目录级说明（README.md）要入库
# 坑：这里必须写 `logs/*` 而不是 `logs/` —— 目录整体被忽略后，git 不会进入它，
#     下面的 `!logs/README.md` 例外永远不会生效（2026-09-20 实测踩到）
logs/*
!logs/README.md
*.log
npm-debug.log*
# 本地起后端时重定向出来的输出（*.log 已覆盖 .log，这里是 .err）
server-dev.err

# Build outputs
dist/
build/

# Test coverage
coverage/

# Local backups
backup/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Playwright CLI 本地快照 / UI 走查产物
.playwright-cli/

# 视觉回归基线的比对临时产物（tools/ops/ui-screenshot-baseline.js --check 的输出）
# baseline/ 那 12 张要入仓；.tmp/ 每次比对都会被覆写，不进版本库
tools/ops/screenshots/.tmp/