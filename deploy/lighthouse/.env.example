# =============================================================================
# EuriskoTax 轻量服务器环境变量模板
# 复制为同目录 .env 后填写；.env 不进仓库（含密钥）
# 密钥生成：openssl rand -hex 32   （Docker CE 镜像的宿主机自带 openssl）
# =============================================================================

# PostgreSQL 密码（compose 会拼成 DATABASE_URL，起一个强随机值后不要再改，改了连不上老数据）
POSTGRES_PASSWORD=改成openssl-rand-hex-32生成

# JWT 签名密钥（生产启动强制校验，不能是默认值）
JWT_SECRET=改成openssl-rand-hex-32生成

# 后台 admin.html 的访问令牌（与 Zeabur 上现值保持一致，否则后台登录会断）
ADMIN_TOKEN=与Zeabur现值一致

# 跨域白名单：同源访问不触发 CORS，IP 测试阶段默认 * 即可；
# 域名切换当天收紧为 https://euriskotax.com
CORS_ORIGIN=*

# 邮件（留资通知等，与 Zeabur 上现值一致；不用邮件就留空）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=EuriskoTax
