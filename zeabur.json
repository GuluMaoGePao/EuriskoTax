{
  "services": {
    "eurisko-tax": {
      "build": {
        "command": "cd server && npm install && npx prisma generate && npx prisma migrate deploy",
        "output": "server"
      },
      "run": {
        "command": "node src/app.js",
        "port": 3000
      }
    }
  },
  "env": {
    "JWT_SECRET": "your-random-secret-key",
    "DATABASE_URL": "file:./dev.db"
  }
}
