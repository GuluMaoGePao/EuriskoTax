{
  "services": {
    "eurisko-tax": {
      "build": {
        "command": "cd server && npm install && npx prisma generate && npx prisma migrate deploy",
        "output": "server"
      },
      "run": {
        "command": "node src/app.js",
        "port": 3000
      }
    }
  },
  "env": {
    "JWT_SECRET": "${JWT_SECRET}",
    "DATABASE_URL": "${DATABASE_URL}",
    "CORS_ORIGIN": "${CORS_ORIGIN}",
    "NODE_ENV": "production"
  }
}
